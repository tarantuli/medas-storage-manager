{
  "name": "morphp/medas-storage-manager",
  "description": "Medas storage manager",
  "keywords": [
    "storage"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../storage-manager-tests"
    }
  ],
  "require": {
    "morphp/medas-cache": "^3",
    "morphp/medas-console": "^4",
    "morphp/medas-core": "^4",
    "morphp/medas-entity-manager": "^3",
    "morphp/medas-object-to-array-serializer": "^3",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^3",
    "morphp/medas-config-options": "^3",
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "morphp/medas-storage-manager-tests": "*",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\StorageManager\\": "src/"
    }
  }
}

